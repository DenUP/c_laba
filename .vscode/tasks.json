{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "mkdir -p \"${fileDirname}\"/.build && /usr/bin/clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/.build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "C++: Build and run active file (terminal)",
            "command": "mkdir -p \"${fileDirname}\"/.build && /usr/bin/clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/.build/${fileBasenameNoExtension}\" && \"${fileDirname}/.build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "type": "shell",
            "label": "C/C++: prepare .build directory (Windows)",
            "command": "if not exist .build mkdir .build",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [],
            "hide": true
        },
        {
            "type": "process",
            "label": "C/C++: g++ build active file (Windows)",
            "command": "g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/.build/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": [
                "C/C++: prepare .build directory (Windows)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "process",
            "label": "C++: Build and run active file (Windows terminal)",
            "command": "${fileDirname}/.build/${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": [
                "C/C++: g++ build active file (Windows)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
