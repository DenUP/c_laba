{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "mkdir -p \"${fileDirname}\"/.build && /usr/bin/clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/.build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "C++: Build and run active file (terminal)",
            "command": "mkdir -p \"${fileDirname}\"/.build && /usr/bin/clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/.build/${fileBasenameNoExtension}\" && \"${fileDirname}/.build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
