{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Debug (macOS Terminal)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/.build/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: clang++ build active file"
        },
        {
            "name": "C++: Debug (integrated terminal, CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/.build/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "terminal": "integrated",
            "preLaunchTask": "C/C++: clang++ build active file"
        },
        {
            "name": "C++: Debug (Windows 11, MinGW-w64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/.build/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ build active file (Windows)"
        }
    ]
}
